/**
 * SITE OPS BOARD — Google Sheets backend
 * ----------------------------------------------------
 * 1. Paste this whole file into an Apps Script project (script.google.com)
 *    bound to (or pointed at) your Google Sheet.
 * 2. Set SHEET_ID and DRIVE_FOLDER_ID below.
 * 3. Run setupSheet() once (from the Apps Script editor) to create the
 *    tabs + headers and seed the starter leads/scripts.
 * 4. Deploy > New deployment > Web app.
 *      Execute as:  Me
 *      Who has access: Anyone
 *    Copy the /exec URL into API_URL in index.html.
 */

const SHEET_ID = '1EuNyBbcoQkQuZK7wPMJ4-LVnX8NT2XKT81DOeD_fQjo';
const DRIVE_FOLDER_ID = '1xbPZYJHmYwcpDhsajQs54nlz_iAjIVHU';

/* ================= WEB APP ENTRY POINTS ================= */

function doGet(e) {
  const sheetName = e.parameter.sheet;
  const sheet = getSheet_(sheetName);
  if (!sheet) return jsonOut_({ error: 'Unknown sheet: ' + sheetName });
  return jsonOut_(sheetToObjects_(sheet));
}

function doPost(e) {
  let body;
  try {
    body = JSON.parse(e.postData.contents);
  } catch (err) {
    return jsonOut_({ error: 'Bad JSON body' });
  }

  const sheet = getSheet_(body.sheet);
  if (!sheet) return jsonOut_({ error: 'Unknown sheet: ' + body.sheet });

  if (body.action === 'insert') {
    insertRow_(sheet, body.data);
    return jsonOut_({ ok: true, data: body.data });
  }

  if (body.action === 'update') {
    updateRow_(sheet, body.idField || 'id', body.data);
    return jsonOut_({ ok: true });
  }

  if (body.action === 'uploadFile') {
    const folder = DriveApp.getFolderById(DRIVE_FOLDER_ID);
    const base64 = String(body.base64 || '').split(',').pop();
    const bytes = Utilities.base64Decode(base64);
    const blob = Utilities.newBlob(bytes, body.mimeType || 'application/octet-stream', body.name);
    const file = folder.createFile(blob);
    file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);

    const meta = {
      id: 'f-' + Date.now(),
      name: body.name,
      mimeType: body.mimeType || '',
      size: body.size || bytes.length,
      driveUrl: file.getUrl(),
      addedBy: body.addedBy || 'unknown',
      ts: Date.now()
    };
    insertRow_(getSheet_('Files'), meta);
    return jsonOut_(meta);
  }

  return jsonOut_({ error: 'Unknown action: ' + body.action });
}

/* ================= ONE-TIME SETUP ================= */

function setupSheet() {
  const ss = SpreadsheetApp.openById(SHEET_ID);

  makeTab_(ss, 'Leads', ['id', 'company', 'type', 'phone', 'area', 'status', 'notes']);
  makeTab_(ss, 'Chat', ['id', 'author', 'text', 'ts']);
  makeTab_(ss, 'Scripts', ['id', 'title', 'tag', 'body']);
  makeTab_(ss, 'Files', ['id', 'name', 'mimeType', 'size', 'driveUrl', 'addedBy', 'ts']);

  seedLeads_(ss);
  seedScripts_(ss);
}

function makeTab_(ss, name, headers) {
  let sheet = ss.getSheetByName(name);
  if (!sheet) sheet = ss.insertSheet(name);
  sheet.clear();
  sheet.appendRow(headers);
  sheet.setFrozenRows(1);
}

