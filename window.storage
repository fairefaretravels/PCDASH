function seedScripts_(ss) {
  const sheet = ss.getSheetByName('Scripts');
  const seed = [
    ["s1", "General Contractor Cold Call Opener", "General Contractors",
      "Who handles your final cleaning before homeowner walkthroughs? I'm looking to become a reliable final-clean vendor for contractors in the Atlanta area."],
    ["s2", "Contractor Intro Pitch", "Remodelers / Builders",
      "I'm building a local final-clean subcontracting company. We help contractors deliver move-in-ready homes without pulling their crews away from construction."],
    ["s3", "Property Manager Pitch", "Property Managers",
      "We help you turn units faster between tenants by handling detailed cleaning and move-in readiness."],
    ["s4", "Restoration Company Pitch", "Restoration Companies",
      "We provide final cleaning support after repairs, helping your team deliver a finished property."],
    ["s5", "Apartment Community Script", "Multifamily / Apartment Communities",
      "Hi, I'm [Your Name] with [Company Name]. We provide insured final cleaning and make-ready services for apartment communities. We help maintenance teams turn units faster between residents by handling detailed cleaning, dust removal, and move-in preparation. Who handles your vendor approvals for turnover cleaning?"]
  ];
  seed.forEach(function (r) {
    sheet.appendRow(r);
  });
}

/* ================= HELPERS ================= */

function getSheet_(name) {
  const ss = SpreadsheetApp.openById(SHEET_ID);
  return ss.getSheetByName(name);
}

function sheetToObjects_(sheet) {
  const values = sheet.getDataRange().getValues();
  if (values.length < 2) return [];
  const headers = values[0];
  return values.slice(1)
    .filter(function (r) { return r.join('') !== ''; })
    .map(function (r) {
      const obj = {};
      headers.forEach(function (h, i) { obj[h] = r[i]; });
      return obj;
    });
}

function insertRow_(sheet, data) {
  const headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
  sheet.appendRow(headers.map(function (h) { return data[h] !== undefined ? data[h] : ''; }));
}

function updateRow_(sheet, idField, data) {
  const values = sheet.getDataRange().getValues();
  const headers = values[0];
  const idCol = headers.indexOf(idField);
  for (let i = 1; i < values.length; i++) {
    if (String(values[i][idCol]) === String(data[idField])) {
      headers.forEach(function (h, colIdx) {
        if (data[h] !== undefined) sheet.getRange(i + 1, colIdx + 1).setValue(data[h]);
      });
      break;
    }
  }
}

function jsonOut_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}
